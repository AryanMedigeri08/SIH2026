# ==============================================================================
# Udyam Saathi (उद्यम साथी) — Environment Configuration Template
# ==============================================================================

# 1. FastAPI REST Backend Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# 2. Database Connection (Neon PostgreSQL / Serverless Postgres)
# Replace placeholder with your Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 3. Firebase Admin (Server-side token verification)
# Option A: Single-line JSON string (preferred for Docker / deployment secrets)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: Local file path fallback (for local development only, gitignored)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=

# 4. LLM API Key & Model (Groq Cloud)
# Used for single-call executive synthesis narrative and regional translation
GROQ_API_KEY=your_groq_api_key_here
# Dedicated Groq Chatbot API Key (Optional; falls back to GROQ_API_KEY if not specified)
GROQ_CHAT_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# 5. Open Government Data / Mission Antyodaya (613 Village Amenities API)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
AMENITIES_API_BASE_URL=https://api.data.gov.in/resource

# 6. Google Cloud Translation API Key (Multi-lingual global translation)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# 7. CORS Allowed Origins (Comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# 8. Sarvam AI — LLM & Language Detection Layer (sarvam-105b-conversations)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_CHAT_ENDPOINT=https://api.sarvam.ai/v1/chat/completions
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text

# 9. Bhashini AI — Primary ASR / STT & TTS Layer (V3: 100% of speech transcription & synthesis)
BHASHINI_USER_ID=your_ulca_user_id_here
BHASHINI_API_KEY=your_ulca_api_key_here
BHASHINI_CONFIG_ENDPOINT=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_CONFIG_CACHE_TTL_SECONDS=3600

# 10. Voice Cascade Controller
VOICE_CASCADE_TIMEOUT_MS=4000
VOICE_FALLBACK_SUPPORTED_LANGS=en,hi,mr,bn,gu,ta,te,kn,pa,ur

