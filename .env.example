# ==============================================================================
# Udyam Saathi (उद्यम साथी) — Environment Configuration Template
# ==============================================================================

# 1. FastAPI REST Backend Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# 2. Database Connection (Neon PostgreSQL / Serverless Postgres)
# Leave blank to run in instant offline memory store mode
DATABASE_URL=postgresql://neondb_owner:npg_uYy3kZ1bFmE4@ep-young-waterfall-a1u0mkw1-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 3. LLM API Key & Model (Groq Cloud)
# Used for single-call executive synthesis narrative and regional translation
# Default: openai/gpt-oss-20b (with automatic resilient fallbacks)
# If blank, Udyam Saathi automatically falls back to 100% deterministic template engine
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# 4. Open Government Data / Mission Antyodaya (613 Village Amenities API)
# Used to fetch live power supply, road connectivity, banking/ATM density, internet & storage metrics.
# If blank or offline, Udyam Saathi automatically resolves infrastructure score using state/district baseline indicators.
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
AMENITIES_API_BASE_URL=https://api.data.gov.in/resource

# 5. CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000","*"]
