# ==============================================================================
# Udyam Saathi (उद्यम साथी) — Environment Configuration Template
# ==============================================================================

# 1. FastAPI REST Backend Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# 2. Database Connection (Neon PostgreSQL / Serverless Postgres)
# Replace placeholder with your Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 3. Firebase Admin (Server-side token verification)
# Option A: Single-line JSON string (preferred for Docker / deployment secrets)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: Local file path fallback (for local development only, gitignored)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=

# 4. LLM API Key & Model (Groq Cloud)
# Used for single-call executive synthesis narrative and regional translation
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# 5. Open Government Data / Mission Antyodaya (613 Village Amenities API)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
AMENITIES_API_BASE_URL=https://api.data.gov.in/resource

# 6. CORS Allowed Origins (Comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
